<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZeroAlloc.Benchmarking</PackageId>
    <RootNamespace>Benchmarking</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Description>Low-level macro-benchmarking and performance-regression harness for multi-threaded daemons and pipelines: pinned worker threads, open-loop pacers, seqlock metrics readers, unmanaged histograms, and budget gating (64-bit AnyCPU).</Description>
    <PackageTags>benchmarking;performance;latency;histogram;pacer;zero-allocation;macrobenchmark;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="ZeroAlloc.Platform" />
  </ItemGroup>
</Project>
